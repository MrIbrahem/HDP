# Meta Wiki Bot Credentials
# Copy this file to .env and fill in your credentials
# DO NOT commit the .env file to version control

# Your Meta Wiki bot username
WIKIPEDIA_BOT_USERNAME=YourBotUsername

# Your bot password (generated from Special:BotPasswords)
WIKIPEDIA_BOT_PASSWORD=YourSecurePassword

# Default: Path("data")
HDP_CACHE_DIR=

# Default: 90
HDP_RECENT_DAYS=

# Default: "HDP-Bot/2.0 (https://meta.wikimedia.org/wiki/Hardware_donation_program; contact: meta.wikimedia.org user Mr. Ibrahem)"
HDP_USER_AGENT=

# Default: "Hardware donation program"
HDP_BASE_PAGE=
